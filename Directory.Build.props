<Project>
  <!-- Réglages communs au moteur et au projet de tests : le zéro avertissement est imposé par la compilation -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Les alertes de sécurité NuGet sur un paquet de test peuvent apparaître sans changement du code : elles ne cassent pas la compilation -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
